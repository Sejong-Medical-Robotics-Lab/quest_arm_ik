  udp_link:
    enabled: true            # false 면 종전처럼 파이썬 브리지 사용
    listen_port: 7001
    state_rate_hz: 100
    # peer_host: 192.168.10.1   # 비우면 Thor 의 HELLO 로 자동 등록
  position_tuning:           # 0 = 드라이버 값 유지. 먼저 로그에 찍힌 현재값을 보고 정한다
    limit_spd_rad_s: 0
    loc_kp: 0
    vel_max_pp_rad_s: 0
    acc_set_pp_rad_s2: 0

