+// ---------------------------------------------------------------------------
+// Direct UDP link (hr::udp::Link) — the Jetson speaks the same command set as
+// the IPC socket, so every link packet is turned into an IpcCommandPacket and
+// goes through dispatch_ipc_command(); nothing else in the controller changes.
+// ---------------------------------------------------------------------------
+struct LinkCounters {
+    uint64_t dispatched{0};       // MoveToPos requests handed to the coordinator
+    uint64_t skipped_disabled{0}; // entries for axes that are not in Run (not enabled)
+    uint64_t unknown_motor{0};    // entries whose motor_id is not a configured/scanned axis
+    uint64_t bad_mode{0};         // CMD packets with command_mode other than 1/6
+};
+
+static uint8_t link_fsm_code(hr::ControllerFsmState s) noexcept
+{
+    switch (s) {
+    case hr::ControllerFsmState::Boot:             return hr::udp::FSM_POWER_OFF;
+    case hr::ControllerFsmState::Init:             return hr::udp::FSM_DRIVER_INIT;
+    case hr::ControllerFsmState::Ready:            return hr::udp::FSM_READY;
+    case hr::ControllerFsmState::Enabling:         return hr::udp::FSM_ENABLING;
+    case hr::ControllerFsmState::ImpedanceControl: return hr::udp::FSM_ENABLED;
+    case hr::ControllerFsmState::OdControl:        return hr::udp::FSM_ENABLED;
+    case hr::ControllerFsmState::MotionRunning:    return hr::udp::FSM_RUNNING;
+    case hr::ControllerFsmState::Pause:            return hr::udp::FSM_ENABLED;
+    case hr::ControllerFsmState::Fault:            return hr::udp::FSM_FAULT;
+    case hr::ControllerFsmState::EmergencyStop:    return hr::udp::FSM_FAULT;
+    default:                                       return hr::udp::FSM_POWER_OFF;
+    }
+}
+
+// motor (CAN node) id of a logical axis: runtime mapping first, config as fallback, 255 = none
+static uint8_t link_motor_of_axis(const std::shared_ptr<hr::CanBusQueues>& can_queues,
+                                  const hr::HrConfig& cfg,
+                                  uint8_t axis_id) noexcept
+{
+    if (can_queues) {
+        const uint8_t mapped = can_queues->node_id_of_axis(axis_id);
+        if (mapped >= 1u && mapped <= hr::SAMHYUN_NODE_ID_MAX) { return mapped; }
+    }
+    if (axis_id >= 1u && axis_id <= hr::NUM_AXES) {
+        const uint8_t configured = cfg.axes[axis_id - 1u].can_node_id;
+        if (configured >= 1u && configured <= hr::SAMHYUN_NODE_ID_MAX) { return configured; }
+    }
+    return 255u;
+}
+
+static uint8_t link_axis_of_motor(const std::shared_ptr<hr::CanBusQueues>& can_queues,
+                                  const hr::HrConfig& cfg,
+                                  uint8_t motor_id) noexcept
+{
+    if (motor_id == 0u || motor_id == 255u) { return 0u; }
+    for (uint8_t axis_id = 1u; axis_id <= hr::NUM_AXES; ++axis_id) {
+        if (link_motor_of_axis(can_queues, cfg, axis_id) == motor_id) { return axis_id; }
+    }
+    return 0u;
+}
+
+// Same content as write_state_json(), read straight from the RT snapshot stores.
+// Entries whose store read fails keep their previous values in `frame`.
+static void fill_link_state(hr::udp::StateFrame& frame,
+                            const hr::ControllerSnapshot& controller,
+                            const std::array<std::shared_ptr<hr::AxisSnapshotStore>, hr::NUM_AXES>& snapshot_stores,
+                            const std::shared_ptr<hr::CanBusQueues>& can_queues,
+                            const hr::HrConfig& cfg,
+                            uint64_t now_us)
+{
+    frame.timestamp_us = now_us;
+    frame.fsm = link_fsm_code(controller.state);
+    frame.axes_connected = controller.axes_connected;
+    frame.axes_enabled = controller.axes_enabled;
+    frame.axes_faulted = controller.axes_faulted;
+    frame.can_ok = controller.can_ok;
+
+    bool run_mode_set = false;
+    for (uint8_t i = 0u; i < hr::NUM_AXES && i < hr::udp::LINK_AXES; ++i) {
+        const uint8_t axis_id = static_cast<uint8_t>(i + 1u);
+        hr::udp::AxisStatus& a = frame.axes[i];
+        a.motor_id = link_motor_of_axis(can_queues, cfg, axis_id);
+        a.channel = can_queues ? can_queues->channel_of_axis(axis_id) : 0u;
+
+        hr::AxisSnapshot snap{};
+        if (!snapshot_stores[i] || !snapshot_stores[i]->read(snap)) {
+            continue;
+        }
+        const uint64_t age_us = now_us > snap.timestamp_us ? (now_us - snap.timestamp_us) : 0u;
+        a.connected = snap.feedback_counter > 0u && age_us <= cfg.coordinator.axis_feedback_stale_us;
+        a.axis_state = static_cast<uint8_t>(snap.state);
+        a.has_fault = snap.fault;
+        a.position = snap.actual_position;
+        a.velocity = snap.actual_velocity;
+        a.effort = snap.actual_torque;
+        if (a.connected && !run_mode_set) {
+            frame.run_mode = snap.configured_run_mode;
+            run_mode_set = true;
+        }
+    }
+}
+
+static IpcCommandPacket link_packet(IpcCommandType type, uint8_t axis_id, float position = 0.0f) noexcept
+{
+    IpcCommandPacket packet{};
+    packet.magic = k_ipc_magic;
+    packet.version = k_ipc_version;
+    packet.type = static_cast<uint16_t>(type);
+    packet.payload.axis_id = axis_id;
+    packet.payload.position = position;
+    return packet;
+}
+
+// CMD: one MoveToPos per listed motor that is currently enabled (AxisState::Run).
+static void handle_link_cmd(irobe::Runtime& runtime,
+                            const std::array<std::shared_ptr<hr::AxisSnapshotStore>, hr::NUM_AXES>& snapshot_stores,
+                            const std::shared_ptr<hr::CanBusQueues>& can_queues,
+                            const hr::HrConfig& cfg,
+                            LinkCounters& counters,
+                            uint8_t mode,
+                            const hr::udp::CommandEntry* entries,
+                            std::size_t count)
+{
+    if (mode != 1u && mode != 6u) {   // UpperBodyCommand: 1 POSITION, 6 POSITION_SERVO — this controller is position-only
+        ++counters.bad_mode;
+        return;
+    }
+    for (std::size_t k = 0; k < count; ++k) {
+        const uint8_t axis_id = link_axis_of_motor(can_queues, cfg, entries[k].motor_id);
+        if (axis_id == 0u) {
+            ++counters.unknown_motor;
+            continue;
+        }
+        hr::AxisSnapshot snap{};
+        const bool have = snapshot_stores[axis_id - 1u] && snapshot_stores[axis_id - 1u]->read(snap);
+        if (!have || snap.state != hr::AxisState::Run) {
+            ++counters.skipped_disabled;   // the coordinator would reject it anyway ("axis_id not monitored" / not enabled)
+            continue;
+        }
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::MoveToPos, axis_id, entries[k].position));
+        ++counters.dispatched;
+    }
+}
+
+// SVC: same numbers as IpcCommandType.  The ACK only confirms that the command was
+// handed to the coordinator; the host watches STATE for the effect (as with the IPC bridge).
+static hr::udp::SvcResult handle_link_svc(irobe::Runtime& runtime,
+                                          const hr::HrCoordinator& coordinator,
+                                          const std::shared_ptr<hr::CanBusQueues>& can_queues,
+                                          const hr::HrConfig& cfg,
+                                          uint16_t svc,
+                                          uint8_t motor_id,
+                                          float value)
+{
+    const hr::ControllerFsmState fsm = coordinator.fsm_state();
+    switch (svc) {
+    case hr::udp::SVC_ENABLE_ALL:
+        if (fsm != hr::ControllerFsmState::Ready &&
+            fsm != hr::ControllerFsmState::ImpedanceControl &&
+            fsm != hr::ControllerFsmState::OdControl) {
+            return {false, std::string("EnableAll rejected: fsm=") + hr::fsm_state_name(fsm)};
+        }
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::EnableAll, 0u));
+        return {true, "ok"};
+    case hr::udp::SVC_DISABLE_ALL:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::DisableAll, 0u));
+        return {true, "ok"};
+    case hr::udp::SVC_EMERGENCY_STOP:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::EmergencyStop, 0u));
+        return {true, "ok"};
+    case hr::udp::SVC_RESET_FAULT:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::ResetFault, 0u));
+        return {true, "ok"};
+    default:
+        break;
+    }
+
+    // per-axis services: motor_id 0 = all axes (coordinator broadcast), except enable/disable axis
+    uint8_t axis_id = 0u;
+    if (motor_id != 0u) {
+        axis_id = link_axis_of_motor(can_queues, cfg, motor_id);
+        if (axis_id == 0u) {
+            return {false, "unknown motor_id " + std::to_string(static_cast<unsigned>(motor_id))};
+        }
+    }
+
+    switch (svc) {
+    case hr::udp::SVC_ENABLE_AXIS:
+    case hr::udp::SVC_DISABLE_AXIS:
+        if (axis_id == 0u) { return {false, "motor_id required"}; }
+        dispatch_ipc_command(runtime, link_packet(svc == hr::udp::SVC_ENABLE_AXIS ? IpcCommandType::EnableAxis
+                                                                                 : IpcCommandType::DisableAxis, axis_id));
+        return {true, "ok"};
+    case hr::udp::SVC_SET_RUN_MODE:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::SetRunMode, axis_id, value));   // mode travels in `position`
+        return {true, "ok"};
+    case hr::udp::SVC_HOME_AXIS:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::HomeAxis, axis_id));
+        return {true, "ok"};
+    case hr::udp::SVC_RESCAN_UID:
+        dispatch_ipc_command(runtime, link_packet(IpcCommandType::RescanUid, axis_id));
+        return {true, "ok"};
+    default:
+        return {false, "unsupported svc " + std::to_string(static_cast<unsigned>(svc))};
+    }
+}
 }
 
