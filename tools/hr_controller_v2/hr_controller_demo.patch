+void AxisUnit::apply_position_tuning() noexcept
+{
+    if (tuning_.limit_spd_rad_s > 0.0f)    { send_od_write_f32(samhyun_can_od::LIMIT_SPD,  tuning_.limit_spd_rad_s); }
+    if (tuning_.loc_kp > 0.0f)             { send_od_write_f32(samhyun_can_od::LOC_KP,     tuning_.loc_kp); }
+    if (tuning_.vel_max_pp_rad_s > 0.0f)   { send_od_write_f32(samhyun_can_od::VEL_MAX_PP, tuning_.vel_max_pp_rad_s); }
+    if (tuning_.acc_set_pp_rad_s2 > 0.0f)  { send_od_write_f32(samhyun_can_od::ACC_SET_PP, tuning_.acc_set_pp_rad_s2); }
+    send_od_read(samhyun_can_od::LIMIT_SPD);
+    send_od_read(samhyun_can_od::LOC_KP);
+    send_od_read(samhyun_can_od::VEL_MAX_PP);
+    send_od_read(samhyun_can_od::ACC_SET_PP);
